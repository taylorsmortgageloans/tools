  html,body{margin:0;padding:0}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,"Helvetica Neue",Arial,sans-serif;
    font-size:16px;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
    -webkit-text-size-adjust:100%;
  }
  .wrap{max-width:1180px;margin:0 auto;padding:20px 16px 56px}
  @media(min-width:768px){ .wrap{padding:32px 24px 72px} }

  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
  .muted{color:var(--ink-3)}
  .tiny{font-size:12px;line-height:1.45}
  .small{font-size:13px}

  /* ---------- Branding ---------- */
  .brand{padding:20px 18px 18px;margin-bottom:16px;position:relative;overflow:hidden}
  @media(min-width:768px){ .brand{padding:24px} }
  .brand::before{
    content:"";position:absolute;top:0;left:0;right:0;height:5px;
    background:linear-gradient(to right,var(--accent) 0 34%,var(--green) 34% 67%,var(--orange) 67% 100%)
  }
  .brand-row{display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between}
  .logo-box{
    width:200px;max-width:62vw;border-radius:10px;display:flex;align-items:center;justify-content:flex-start;overflow:hidden
  }
  .logo-box.placeholder{
    width:180px;height:84px;background:var(--accent-soft);border:1px dashed #BBD5E6;
    align-items:center;justify-content:center;color:var(--accent);font-size:11px;font-weight:700;
    letter-spacing:.06em;text-align:center;text-transform:uppercase
  }
  .logo-box img{width:100%;height:auto;display:block}
  .brand-name{font-size:19px;font-weight:700;letter-spacing:-.01em;margin:0}
  .brand-sub{font-size:13.5px;color:var(--ink-2);margin:3px 0 0}
  .brand-right{text-align:left;min-width:0}
  @media(min-width:768px){ .brand-right{text-align:right} }
  .brand-tag{font-size:12.5px;font-weight:700;letter-spacing:.02em;margin:8px 0 0;color:var(--ink-3)}
  .brand-tag b:nth-of-type(1){color:var(--accent)}
  .brand-tag b:nth-of-type(2){color:var(--green-ink)}
  .brand-tag b:nth-of-type(3){color:var(--orange)}
  .brand-pill{
    display:inline-block;background:var(--green-soft);color:var(--green-ink);border:1px solid #DCEBCC;
    border-radius:999px;padding:5px 12px;font-size:12px;font-weight:700;margin-top:8px
  }
  .link-btn{
    background:none;border:0;color:var(--accent);font:inherit;font-size:13px;font-weight:600;
    cursor:pointer;padding:8px 0;text-decoration:underline;text-underline-offset:3px
  }
  .brand-edit{margin-top:18px;border-top:1px solid var(--line-2);padding-top:18px}
  .grid-fields{display:grid;gap:12px;grid-template-columns:1fr}
  @media(min-width:640px){ .grid-fields{grid-template-columns:1fr 1fr} }
  @media(min-width:960px){ .grid-fields{grid-template-columns:1fr 1fr 1fr} }

