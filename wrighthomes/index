    --bg:#F5F7F9;
    --surface:#FFFFFF;
    --ink:#16222B;
    --ink-2:#48575F;
    --ink-3:#7B8992;
    --line:#E2E7EB;
    --line-2:#EFF2F5;
    --accent:#0066A4;
    --accent-soft:#E8F2F8;
    --accent-ink:#004E7D;
    --green:#5FA845;
    --green-soft:#EFF7E7;
    --green-ink:#4C7F28;
    --orange:#F5831F;
    --warn-bg:#FEF4E6;
    --warn-ink:#9A5E12;
