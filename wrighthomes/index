     Conventional carries the 3-2-1 temporary buydown and therefore shows a four-step
     payment schedule. FHA and VA are shown as a 5/1 ARM with no temporary buydown,
     so each shows a single payment for the full initial fixed period.

     Each schedule step: rate is the PAYMENT rate used to amortize the financed loan
     amount over termYears. Set buydown: true on any step funded by buydown dollars. ---- */
  products: {
    conventional: {
      productName: "7/6 ARM",
      termYears: 30,
      noteRate: 0.0499,
      fixedPeriodYears: 7,
      adjustmentFrequency: "every six months",
      buydownName: "3-2-1 temporary buydown",
      schedule: [
        { key: "y1", label: "Year 1",    rate: 0.0199, buydown: true,  note: "Temporary buydown payment" },
        { key: "y2", label: "Year 2",    rate: 0.0299, buydown: true,  note: "Temporary buydown payment" },
        { key: "y3", label: "Year 3",    rate: 0.0399, buydown: true,  note: "Temporary buydown payment" },
        { key: "y4", label: "Years 4-7", rate: 0.0499, buydown: false, note: "Note rate payment through Year 7" }
      ]
    },
    fha: {
      productName: "5/1 ARM",
      termYears: 30,
      noteRate: 0.03375,
      fixedPeriodYears: 5,
      adjustmentFrequency: "annually",
      buydownName: null,
      schedule: [
        { key: "y1", label: "Years 1-5", rate: 0.03375, buydown: false, note: "Note rate payment through Year 5" }
      ]
    },
    va: {
      productName: "5/1 ARM",
      termYears: 30,
      noteRate: 0.03375,
      fixedPeriodYears: 5,
      adjustmentFrequency: "annually",
      buydownName: null,
      schedule: [
        { key: "y1", label: "Years 1-5", rate: 0.03375, buydown: false, note: "Note rate payment through Year 5" }
      ]
    }
  },

  /* ---- Escrows ---- */
  propertyTaxAnnualRate: 0.0058,   // annual taxes = price x this rate

  homeownersInsurance: {
    priceThreshold: 500000,        // above this price -> monthlyAmount, at/below -> 0
    monthlyAmount: 85,
    excludedMessage: "Insurance not included based on current builder estimate."
  },

  /* ---- Loan-type assumptions ---- */
  conventional: {
    label: "Conventional",
    defaultDownPaymentPercent: 5,
    // Simplified annual PMI table, 740+ credit score. Ordered low LTV -> high LTV.
    pmiTiers: [
      { maxLtv: 0.80, annualRate: 0.0000 },
      { maxLtv: 0.85, annualRate: 0.0015 },
      { maxLtv: 0.90, annualRate: 0.0025 },
      { maxLtv: 0.95, annualRate: 0.0035 },
      { maxLtv: Infinity, annualRate: 0.0055 }
    ],
    miLabel: "Estimated mortgage insurance",
    miTooltip: "Conventional mortgage insurance is estimated using a 740+ credit profile. Actual mortgage insurance depends on credit, loan-to-value ratio, property type, insurer, and final loan approval."
  },

  fha: {
    label: "FHA",
    defaultDownPaymentPercent: 3.5,
    upfrontMipRate: 0.0175,        // financed into the loan
    annualMipRate: 0.0055,         // monthly MIP = base loan x rate / 12
    miLabel: "Estimated FHA mortgage insurance",
    miTooltip: "FHA mortgage insurance shown is an estimate. The upfront mortgage insurance premium is assumed financed into the loan amount. Actual FHA mortgage insurance depends on loan term, loan-to-value ratio, and final loan approval.",
    note: "FHA figures are estimates. The 1.75% upfront mortgage insurance premium is assumed financed into the loan amount."
  },

  va: {
    label: "VA",
    defaultDownPaymentPercent: 0,
    fundingFeeRate: 0.0215,        // fixed simplified assumption, financed
    monthlyMortgageInsurance: 0,
    miLabel: "Monthly mortgage insurance",
    note: "VA funding fees may vary, and some eligible borrowers may be exempt. This estimate assumes a financed 2.15% funding fee."
  },

  /* ---- Floor plans. Listed alphabetically; the price auto-fills into the
     purchase-price field when a plan is selected and stays editable.
     Set a price to null for any plan that does not have pricing yet. ---- */
  floorPlans: [
    { name: "Aspen",       price: 610900 },
    { name: "Astoria",     price: 451900 },
    { name: "Austin",      price: 423900 },
    { name: "Brooklyn",    price: 623900 },
    { name: "Charlotte",   price: 613900 },
    { name: "Dallas",      price: 419900 },
    { name: "Denver",      price: 626900 },
    { name: "Eden",        price: 449900 },
    { name: "Holland",     price: 445900 },
    { name: "Holland End", price: 459900 },
    { name: "London",      price: 455900 },
    { name: "Maui",        price: 473900 },
    { name: "Memphis",     price: 447900 },
    { name: "Quincey",     price: 478900 }
  ],

  defaultSelectedPlans: ["Aspen", "Charlotte", "Brooklyn"],

  /* ---- Disclosure language ---- */
  disclosures: {
    shortNotice: "Estimated payment only. Prepared by Wright Homes to illustrate the current preferred-lender incentive. This is not a loan quote, pre-approval, or commitment to lend.",
    notALenderQuote: "This tool is provided by Wright Homes for illustration only. Wright Homes is a homebuilder and does not originate, provide, or approve financing. These figures are not a quote, Loan Estimate, pre-qualification, or approval from any lender. All financing is provided through a lender of the buyer's choosing, including the Wright Homes preferred lender, and only that lender can confirm rates, program eligibility, incentive availability, payment amounts, and final loan approval.",
    full: "Payment figures are estimates for illustration purposes only and are not a commitment to lend, loan approval, interest-rate lock, or Loan Estimate. Wright Homes does not provide financing directly and does not guarantee loan approval, interest rates, or program availability. Actual rates, payments, mortgage insurance, taxes, homeowners insurance, funding fees, closing costs, and loan terms may vary based on borrower qualifications, property details, market conditions, lender guidelines, and final underwriting approval. Temporary buydown funds, where applicable, reduce the borrower's scheduled payment for a limited period and do not change the note rate. Adjustable-rate loans are fixed only for the initial period shown and may adjust afterward, so payments after that period are not known today and may be higher. Loan program availability, including any temporary buydown, is determined by the lender and may differ by loan type. HOA dues are not included. All financing is subject to credit approval and underwriting by the lender. Equal Housing Opportunity.",
    exclusions: "Payments include principal, interest, estimated property taxes, estimated homeowners insurance when applicable, and estimated mortgage insurance when applicable. HOA dues, closing costs, utilities, maintenance, supplemental taxes, special assessments, optional insurance, and any builder upgrades not already reflected in the purchase price shown are not included."
  }
};
/* ======================  END CONFIGURATION  ============================= */


/* =========================================================================
   Calculation utilities — single source of truth for all math.
   ========================================================================= */
const LOAN_TYPES = ["conventional", "fha", "va"];
const typeCfg = (loanType) => CONFIG[loanType];
const productCfg = (loanType) => CONFIG.products[loanType];

function calculateBaseLoanAmount(purchasePrice, downPayment) {
  return Math.max(0, purchasePrice - downPayment);
}

function calculateFHAUpfrontMIP(baseLoanAmount) {
  return baseLoanAmount * CONFIG.fha.upfrontMipRate;
}

function calculateVAFundingFee(baseLoanAmount) {
  return baseLoanAmount * CONFIG.va.fundingFeeRate;
}

/** Financed amount actually used for principal & interest. */
function calculateFinancedLoanAmount(baseLoanAmount, loanType) {
  if (loanType === "fha") return baseLoanAmount + calculateFHAUpfrontMIP(baseLoanAmount);
  if (loanType === "va")  return baseLoanAmount + calculateVAFundingFee(baseLoanAmount);
  return baseLoanAmount;
}

/** Standard fixed-payment amortization: P x [r(1+r)^n] / [(1+r)^n - 1] */
function calculateMonthlyPrincipalAndInterest(principal, annualRate, termYears) {
  if (!(principal > 0)) return 0;
  const n = termYears * 12;
  const r = annualRate / 12;
  if (r === 0) return principal / n;
  const growth = Math.pow(1 + r, n);
  return (principal * r * growth) / (growth - 1);
}

function calculateMonthlyTaxes(purchasePrice) {
  if (!(purchasePrice > 0)) return 0;
  return (purchasePrice * CONFIG.propertyTaxAnnualRate) / 12;
}

function calculateHomeownersInsurance(purchasePrice) {
  const { priceThreshold, monthlyAmount } = CONFIG.homeownersInsurance;
  return purchasePrice > priceThreshold ? monthlyAmount : 0;
}

function conventionalPmiRate(ltv) {
  const tier = CONFIG.conventional.pmiTiers.find(t => ltv <= t.maxLtv);
  return tier ? tier.annualRate : 0;
}

function calculateConventionalPMI(baseLoanAmount, ltv) {
  return (baseLoanAmount * conventionalPmiRate(ltv)) / 12;
}

function calculateFHAMIP(baseLoanAmount) {
  return (baseLoanAmount * CONFIG.fha.annualMipRate) / 12;
}

function calculateMonthlyMortgageInsurance(baseLoanAmount, ltv, loanType) {
  if (loanType === "conventional") return calculateConventionalPMI(baseLoanAmount, ltv);
  if (loanType === "fha") return calculateFHAMIP(baseLoanAmount);
  return CONFIG.va.monthlyMortgageInsurance;
}

/**
 * Full scenario for one home. Returns every figure the UI displays,
 * at full internal precision (rounding happens only at display time).
 */
function calculatePaymentScenario({ purchasePrice, downPayment, loanType }) {
  const product = productCfg(loanType);
  const price = Math.max(0, purchasePrice || 0);
  const down = Math.min(Math.max(0, downPayment || 0), price);

  const baseLoanAmount = calculateBaseLoanAmount(price, down);
  const ltv = price > 0 ? baseLoanAmount / price : 0;
  const downPercent = price > 0 ? (down / price) * 100 : 0;

  const financedUpfront =
    loanType === "fha" ? calculateFHAUpfrontMIP(baseLoanAmount) :
    loanType === "va"  ? calculateVAFundingFee(baseLoanAmount) : 0;

  const financedLoanAmount = calculateFinancedLoanAmount(baseLoanAmount, loanType);
  const monthlyTaxes = calculateMonthlyTaxes(price);
  const monthlyInsurance = calculateHomeownersInsurance(price);
  const monthlyMI = calculateMonthlyMortgageInsurance(baseLoanAmount, ltv, loanType);
  const pmiRate = loanType === "conventional" ? conventionalPmiRate(ltv)
                : loanType === "fha" ? CONFIG.fha.annualMipRate : 0;

  // Components are computed at full precision, then rounded to cents for display so
  // that the itemized breakdown always sums exactly to the displayed total.
  const round2 = (n) => Math.round((n + Number.EPSILON) * 100) / 100;

  const buildYear = (step) => {
    const pi = round2(calculateMonthlyPrincipalAndInterest(financedLoanAmount, step.rate, product.termYears));
    const tax = round2(monthlyTaxes);
    const hoi = round2(monthlyInsurance);
    const mi = round2(monthlyMI);
    return {
      key: step.key,
      label: step.label,
      rate: step.rate,
      note: step.note,
      buydown: !!step.buydown,
      principalAndInterest: pi,
      taxes: tax,
      insurance: hoi,
      mortgageInsurance: mi,
      total: round2(pi + tax + hoi + mi)
    };
  };

  const years = product.schedule.map(buildYear);

  return {
    price, down, downPercent, baseLoanAmount, ltv,
    financedUpfront, financedLoanAmount,
    monthlyTaxes, monthlyInsurance, monthlyMI, pmiRate,
    hasFinancedAddOn: financedUpfront > 0.005,
    product,
    hasBuydown: years.some(y => y.buydown),
    years
  };
}


/* =========================================================================
   Formatting helpers
   ========================================================================= */
const usd0 = (n) => "$" + Math.round(n || 0).toLocaleString("en-US");
const usd2 = (n) => "$" + (n || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const pct = (n, d = 2) => (isFinite(n) ? n.toFixed(d).replace(/\.00$/, "") : "0") + "%";
/* Interest rates carry up to three decimals (3.375%), so they get their own
   formatter — pct() would round that to 3.38%. Trailing zeros are trimmed. */
const rateText = (decimalRate) =>
  (isFinite(decimalRate) ? Number((decimalRate * 100).toFixed(3)) : 0) + "%";
/* "Year 1 at 1.99%, Year 2 at 2.99%, ..." — generated so disclosure prose can
   never drift out of sync with the schedule above. */
const scheduleText = (product) =>
  product.schedule.map(s => s.label + " at " + rateText(s.rate)).join(", ");
const digitsOnly = (s) => String(s).replace(/[^\d]/g, "").replace(/^0+(?=\d)/, "");
const groupDigits = (d) => (d === "" ? "" : Number(d).toLocaleString("en-US"));
const toNumber = (s) => { const n = parseFloat(String(s).replace(/,/g, "")); return isFinite(n) ? n : 0; };


/* =========================================================================
   Inputs
   ========================================================================= */

/** Whole-dollar input that keeps commas without the caret jumping. */
function CurrencyInput({ value, onChange, id, ariaLabel, placeholder }) {
  const ref = useRef(null);
  const caret = useRef(null);

  useEffect(() => {
    if (caret.current != null && ref.current && document.activeElement === ref.current) {
      ref.current.setSelectionRange(caret.current, caret.current);
    }
    caret.current = null;
  });

  const handle = (e) => {
    const el = e.target;
    const selStart = el.selectionStart == null ? el.value.length : el.selectionStart;
    const digitsBefore = el.value.slice(0, selStart).replace(/[^\d]/g, "").length;
    const digits = digitsOnly(el.value);
    const formatted = groupDigits(digits);

    let seen = 0, pos = formatted.length;
    if (digitsBefore === 0) {
      pos = 0;
    } else {
      for (let i = 0; i < formatted.length; i++) {
        if (/\d/.test(formatted[i])) seen++;
        if (seen === digitsBefore) { pos = i + 1; break; }
      }
    }
    caret.current = pos;
    onChange(digits);
  };

  return (
    <div className="input-affix pre">
      <span className="affix">$</span>
      <input
        id={id} ref={ref} className="txt" type="text"
        inputMode="numeric" autoComplete="off" aria-label={ariaLabel}
        placeholder={placeholder || "0"}
        value={groupDigits(value)} onChange={handle}
      />
    </div>
  );
}

/** Percent input allowing one decimal point, never negative. */
function PercentInput({ value, onChange, id, ariaLabel }) {
  const handle = (e) => {
    let v = e.target.value.replace(/[^\d.]/g, "");
    const parts = v.split(".");
    if (parts.length > 2) v = parts[0] + "." + parts.slice(1).join("");
    if (toNumber(v) > 100) v = "100";
    onChange(v);
  };
  return (
    <div className="input-affix post">
      <span className="affix">%</span>
      <input id={id} className="txt" type="text" inputMode="decimal" autoComplete="off"
             aria-label={ariaLabel} value={value} onChange={handle} placeholder="0" />
    </div>
  );
}

function Segmented({ options, value, onChange, ariaLabel, two }) {
  return (
    <div className={"seg" + (two ? " two" : "")} role="group" aria-label={ariaLabel}>
      {options.map(o => (
        <button key={o.value} type="button" aria-pressed={value === o.value}
                onClick={() => onChange(o.value)}>{o.label}</button>
      ))}
    </div>
  );
}


