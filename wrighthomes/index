/* =========================================================================
   App
   ========================================================================= */
function App() {
  const [branding, setBranding] = useState(CONFIG.branding);
  const [loanType, setLoanTypeRaw] = useState("conventional");
  const [dpMode, setDpModeRaw] = useState("percent");
  const [dpTouched, setDpTouched] = useState(false);

  const [dpPercent, setDpPercentRaw] = useState(String(CONFIG.conventional.defaultDownPaymentPercent));
  const [dpDollars, setDpDollarsRaw] = useState("");

  const [columns, setColumns] = useState(() =>
    CONFIG.defaultSelectedPlans.map(name => {
      const plan = CONFIG.floorPlans.find(p => p.name === name);
      return {
        planName: plan ? plan.name : "",
        priceDigits: plan && plan.price != null ? String(plan.price) : ""
      };
    })
  );

  const setDpPercent = (v) => { setDpPercentRaw(v); setDpTouched(true); };
  const setDpDollars = (v) => { setDpDollarsRaw(v); setDpTouched(true); };

  /* Loan type change: only reset the down payment if the agent has not edited it. */
  const setLoanType = (t) => {
    setLoanTypeRaw(t);
    if (!dpTouched) {
      const defPct = typeCfg(t).defaultDownPaymentPercent;
      setDpPercentRaw(String(defPct));
      const firstPrice = toNumber(columns[0].priceDigits);
      setDpDollarsRaw(firstPrice > 0 ? String(Math.round(firstPrice * defPct / 100)) : "");
    }
  };

  /* Mode change: convert and synchronize using the first priced home as the reference. */
  const setDpMode = (mode) => {
    if (mode === dpMode) return;
    const ref = columns.map(c => toNumber(c.priceDigits)).find(p => p > 0) || 0;
    if (mode === "dollar") {
      setDpDollarsRaw(ref > 0 ? String(Math.round(ref * toNumber(dpPercent) / 100)) : "");
    } else {
      setDpPercentRaw(ref > 0 ? String(Number(((toNumber(dpDollars) / ref) * 100).toFixed(3))) : "0");
    }
    setDpModeRaw(mode);
  };

  return (
    <div className="wrap">
      <BrandingHeader branding={branding} setBranding={setBranding} />

      <h1 className="title">{branding.pageTitle}</h1>
      <p className="subtitle">{branding.pageSubtitle}</p>

      <BuyerInputs
        loanType={loanType} setLoanType={setLoanType}
        dpMode={dpMode} setDpMode={setDpMode}
        dpPercent={dpPercent} setDpPercent={setDpPercent}
        dpDollars={dpDollars} setDpDollars={setDpDollars}
      />

      <FloorPlanComparison
        columns={columns} setColumns={setColumns}
        loanType={loanType} dpMode={dpMode} dpPercent={dpPercent} dpDollars={dpDollars}
      />

      <DisclosureFooter branding={branding} />
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
