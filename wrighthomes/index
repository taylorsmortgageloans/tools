            <p className="bd-note">
              {scenario.hasBuydown
                ? "The " + product.buydownName + " lowers the scheduled payment for the first " +
                  (product.schedule.filter(s => s.buydown).length) +
                  " years. It does not change the " + rateText(product.noteRate) + " note rate, and qualifying is based on that note rate."
                : "No temporary buydown is applied to " + cfg.label + " financing. The payment shown is the " +
                  rateText(product.noteRate) + " note rate payment, fixed for the initial " +
                  product.fixedPeriodYears + " years and adjusting " + product.adjustmentFrequency + " after that."}
            </p>
            {insuranceExcluded && <p className="bd-note">{CONFIG.homeownersInsurance.excludedMessage}</p>}
