/* =========================================================================
   PaymentSummary + PaymentBreakdown
   ========================================================================= */
function PaymentSummary({ scenario, valid }) {
  return (
    <div className="years">
      {scenario.years.map((y, i) => (
        <div key={y.key} className={"year" + (i === scenario.years.length - 1 ? " hl" : "")}>
          <div className="year-top">
            <p className="year-name">{y.label}</p>
            <span className={"rate-chip" + (y.buydown ? " buydown" : "")}>{rateText(y.rate)} payment rate</span>
          </div>
