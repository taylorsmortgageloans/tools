            <div className="bd-row"><span>Note rate</span><span>{rateText(product.noteRate)}</span></div>
            <div className="bd-row"><span>Purchase price</span><span>{usd0(scenario.price)}</span></div>
            <div className="bd-row"><span>Down payment</span><span>{usd0(scenario.down)} ({pct(scenario.downPercent)})</span></div>
            <div className="bd-row"><span>Base loan amount</span><span>{usd0(scenario.baseLoanAmount)}</span></div>
            {loanType === "fha" && (
              <div className="bd-row"><span>Financed upfront MIP ({pct(CONFIG.fha.upfrontMipRate * 100)})</span><span>{usd0(scenario.financedUpfront)}</span></div>
            )}
            {loanType === "va" && (
              <div className="bd-row"><span>Financed VA funding fee ({pct(CONFIG.va.fundingFeeRate * 100)})</span><span>{usd0(scenario.financedUpfront)}</span></div>
            )}
            <div className="bd-row total"><span>Total financed loan amount</span><span>{usd0(scenario.financedLoanAmount)}</span></div>
            <div className="bd-row"><span>Loan-to-value (base loan)</span><span>{pct(scenario.ltv * 100, 2)}</span></div>
            {loanType === "va" && <p className="bd-note">{CONFIG.va.note}</p>}
            {loanType === "fha" && <p className="bd-note">{CONFIG.fha.note}</p>}
          </div>

          {scenario.years.map(y => (
            <div className="bd-block" key={y.key}>
              <p className="bd-title">{y.label} — {rateText(y.rate)}</p>
              <div className="bd-row"><span>Principal &amp; interest</span><span>{usd2(y.principalAndInterest)}</span></div>
              <div className="bd-row"><span>Property taxes</span><span>{usd2(y.taxes)}</span></div>
              <div className="bd-row">
                <span>Homeowners insurance</span>
                <span>{usd2(y.insurance)}</span>
              </div>
              <div className="bd-row">
                <span>{cfg.miLabel}</span>
                <span>{usd2(y.mortgageInsurance)}</span>
              </div>
              <div className="bd-row total"><span>Total estimated payment</span><span>{usd2(y.total)}</span></div>
            </div>
          ))}

