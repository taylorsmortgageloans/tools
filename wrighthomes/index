            {valid ? usd0(y.total) : "—"} <span>/mo</span>
          </p>
          <p className="year-note">{y.note}</p>
        </div>
      ))}
    </div>
  );
}

function PaymentBreakdown({ scenario, loanType, open, onToggle, id }) {
  const cfg = typeCfg(loanType);
