  );
}


/* =========================================================================
   FloorPlanCard
   ========================================================================= */
function FloorPlanCard({ index, column, onChange, loanType, dpMode, dpPercent, dpDollars, openAll }) {
  const [open, setOpen] = useState(false);
  useEffect(() => { if (openAll != null) setOpen(openAll); }, [openAll]);

  const price = toNumber(column.priceDigits);
  const requestedDown = dpMode === "percent"
    ? price * (toNumber(dpPercent) / 100)
    : toNumber(dpDollars);

  const priceMissing = column.priceDigits === "" || price <= 0;
  const downExceeds = !priceMissing && requestedDown > price;
  const valid = !priceMissing && !downExceeds;

  const scenario = useMemo(
    () => calculatePaymentScenario({ purchasePrice: price, downPayment: requestedDown, loanType }),
    [price, requestedDown, loanType]
  );

  const selectPlan = (e) => {
    const name = e.target.value;
    const plan = CONFIG.floorPlans.find(p => p.name === name);
    onChange({
      planName: name,
      priceDigits: plan && plan.price != null ? String(plan.price) : ""
    });
  };

  return (
    <article className="card home" aria-label={"Home " + (index + 1)}>
      <div className="home-head">
        <p className="home-eyebrow">Home {index + 1}</p>

        <label className="lbl" htmlFor={"plan" + index}>Floor plan</label>
        <select id={"plan" + index} className="txt" value={column.planName} onChange={selectPlan}>
          <option value="">Select a floor plan</option>
          {CONFIG.floorPlans.map(p => (
            <option key={p.name} value={p.name}>
              {p.name}
            </option>
          ))}
        </select>

        <div style={{ marginTop: 14 }}>
          <label className="lbl" htmlFor={"price" + index}>Purchase price (editable)</label>
          <CurrencyInput
            id={"price" + index}
            ariaLabel={"Purchase price for home " + (index + 1)}
            value={column.priceDigits}
            onChange={(digits) => onChange({ ...column, priceDigits: digits })}
          />
          <p className="tiny muted" style={{ margin: "6px 0 0" }}>
            Adjust for upgrades, options, or lot premium.
          </p>
        </div>

        {priceMissing && (
          <div className="warn">Enter a purchase price to see estimated payments.</div>
        )}
        {downExceeds && (
          <div className="warn">
            The down payment ({usd0(requestedDown)}) is more than this home's price. Lower the down payment to see estimated payments.
          </div>
        )}

        <div className="facts">
          <div className="fact"><span>Down payment</span><b>{valid ? usd0(scenario.down) : "—"}</b></div>
          <div className="fact"><span>Down payment percent</span><b>{valid ? pct(scenario.downPercent) : "—"}</b></div>
          <div className="fact"><span>Base loan amount</span><b>{valid ? usd0(scenario.baseLoanAmount) : "—"}</b></div>
          {valid && scenario.hasFinancedAddOn && (
            <React.Fragment>
              <div className="fact">
                <span>{loanType === "fha" ? "Financed upfront MIP" : "Financed VA funding fee"}</span>
                <b>{usd0(scenario.financedUpfront)}</b>
              </div>
              <div className="fact"><span>Total financed loan</span><b>{usd0(scenario.financedLoanAmount)}</b></div>
            </React.Fragment>
          )}
          <div className="fact">
            <span>Est. taxes &amp; insurance</span>
            <b>{valid ? usd0(scenario.monthlyTaxes + scenario.monthlyInsurance) + "/mo" : "—"}</b>
          </div>
        </div>

        {valid && scenario.monthlyInsurance === 0 && (
          <p className="tiny muted" style={{ margin: "10px 0 0" }}>
            {CONFIG.homeownersInsurance.excludedMessage}
          </p>
        )}
      </div>

      <PaymentSummary scenario={scenario} valid={valid} />

      <PaymentBreakdown
        id={"bd" + index}
        scenario={scenario}
        loanType={loanType}
        open={open && valid}
        onToggle={() => setOpen(v => !v)}
      />
    </article>
  );
}


/* =========================================================================
   FloorPlanComparison
   ========================================================================= */
function FloorPlanComparison({ columns, setColumns, loanType, dpMode, dpPercent, dpDollars }) {
  const [openAll, setOpenAll] = useState(null);
  const update = (i) => (next) => {
    const copy = columns.slice();
    copy[i] = next;
    setColumns(copy);
  };
  return (
    <section aria-label="Home comparison">
      <div className="notice">
        <span className="dot" aria-hidden="true">●</span>
        <span>{CONFIG.disclosures.shortNotice}</span>
      </div>
      <div className="cols">
        {columns.map((c, i) => (
          <FloorPlanCard
            key={i} index={i} column={c} onChange={update(i)}
            loanType={loanType} dpMode={dpMode} dpPercent={dpPercent} dpDollars={dpDollars}
            openAll={openAll}
          />
        ))}
      </div>
      <div style={{ textAlign: "center", marginTop: 12 }}>
        <button className="link-btn" type="button"
                onClick={() => setOpenAll(v => (v === true ? false : true))}>
          {openAll === true ? "Hide all payment breakdowns" : "Show all payment breakdowns"}
        </button>
      </div>
    </section>
  );
}


